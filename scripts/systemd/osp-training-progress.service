[Unit]
Description=Publish OSP native training progress and finalized simulation videos

[Service]
Type=oneshot
WorkingDirectory=%h/simul
ExecStart=/usr/bin/python3 %h/simul/scripts/publish_training_progress.py --source %h/simul --campaign %h/simul/training_robust/native90/official_frontier_comparison_v1 --follow-campaign %h/simul/training_robust/native90/official_rolling_goal_comparison_v1 --follow-campaign %h/simul/training_robust/native90/frontier_coverage_comparison_v1 --follow-campaign %h/simul/training_robust/native90/official_navigation_budget_comparison_v1 --follow-campaign %h/simul/training_robust/native90/official_integrated_comparison_v1 --follow-campaign %h/simul/training_robust/native90/official_frontier_evidence_screen_v1 --follow-campaign %h/simul/training_robust/native90/official_local_grid_matrix_v1 --checkout %h/simul/deployment/github_progress --publish --videos
MemoryMax=768M
TimeoutStartSec=30min
