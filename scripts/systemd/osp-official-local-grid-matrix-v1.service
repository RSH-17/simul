[Unit]
Description=Resume the frozen official TurtleBot4 condition matrix

[Service]
Type=simple
WorkingDirectory=%h/simul
ExecStart=/usr/bin/python3 -u %h/simul/training_robust/run_official_local_grid_matrix.py --output %h/simul/training_robust/native90/official_local_grid_matrix_v1
MemoryMax=768M
Restart=no
StandardOutput=append:%h/simul/training_robust/native90/official_local_grid_matrix_v1/coordinator.log
StandardError=append:%h/simul/training_robust/native90/official_local_grid_matrix_v1/coordinator.log
