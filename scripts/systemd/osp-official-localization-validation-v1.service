[Unit]
Description=Official TurtleBot4 odom IMU shadow and guarded coordinates validation

[Service]
Type=simple
WorkingDirectory=%h/simul
ExecStart=/usr/bin/python3 -u %h/simul/training_robust/run_localization_validation.py --output %h/simul/training_robust/native90/official_localization_validation_v1 --run-prepared
MemoryMax=768M
Restart=no
StandardOutput=append:%h/simul/training_robust/native90/official_localization_validation_v1/coordinator.log
StandardError=append:%h/simul/training_robust/native90/official_localization_validation_v1/coordinator.log
