[Unit]
Description=Queued TurtleBot4 rolling exploration destination experiment

[Service]
Type=simple
WorkingDirectory=%h/simul
ExecStart=/usr/bin/python3 -u %h/simul/training_robust/run_rolling_goal_comparison.py --output %h/simul/training_robust/native90/official_rolling_goal_comparison_v1 --run-prepared
MemoryMax=768M
Restart=no
StandardOutput=append:%h/simul/training_robust/native90/official_rolling_goal_comparison_v1/coordinator.log
StandardError=append:%h/simul/training_robust/native90/official_rolling_goal_comparison_v1/coordinator.log
