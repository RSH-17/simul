[Unit]
Description=Frozen official TurtleBot4 dock repair departure comparisons

[Service]
Type=simple
WorkingDirectory=%h/simul
ExecStart=/usr/bin/python3 -u %h/simul/training_robust/run_official_dock_screen.py --output %h/simul/training_robust/native90/official_dock_screen_v1 --run-prepared
MemoryMax=768M
Restart=no
StandardOutput=append:%h/simul/training_robust/native90/official_dock_screen_v1/coordinator.log
StandardError=append:%h/simul/training_robust/native90/official_dock_screen_v1/coordinator.log
