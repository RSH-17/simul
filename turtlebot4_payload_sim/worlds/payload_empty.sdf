<?xml version="1.0"?>
<sdf version="1.9">
  <world name="payload_empty">
    <physics name="default" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>1 1 1 1</ambient><background>0.1 0.1 0.1 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.5 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="external_obstacle">
      <static>true</static><pose>1.0 0 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.1 0.1 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 0.1 0.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 2.5 0.4 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>5 0.1 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>5 0.1 0.8</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -2.5 0.4 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>5 0.1 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>5 0.1 0.8</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>2.5 0 0.4 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 5 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 5 0.8</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-2.5 0 0.4 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 5 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 5 0.8</size></box></geometry></visual></link></model>
  </world>
</sdf>
